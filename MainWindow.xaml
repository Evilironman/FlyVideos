<Window x:Class="FlyVideos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FlyVideos"
        Width="960" Height="636"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF0B0B0C"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="ButtonNormal" Color="#CC232327"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#E63A3A42"/>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <MediaElement x:Name="Player" Grid.Row="0"
                      Stretch="Uniform"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      ScrubbingEnabled="True"/>

        <Grid x:Name="OsdLayer" Grid.Row="0" IsHitTestVisible="False">
            <Grid VerticalAlignment="Top" Margin="18,13,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,28,0">
                    <TextBlock x:Name="TitleText" Foreground="#F2FFFFFF" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" Foreground="#8CFFFFFF" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="HintText" Grid.Column="1" Foreground="#66FFFFFF" FontSize="11" VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Foreground="#D9FFFFFF" FontSize="13" Opacity="0" IsHitTestVisible="False"/>
        <TextBlock x:Name="ErrorText" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="640" Visibility="Collapsed" IsHitTestVisible="False"/>

        <StackPanel x:Name="SpeedPanel" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12" Opacity="0" IsHitTestVisible="False">
            <Border x:Name="SpeedDownButton" Width="38" Height="30" CornerRadius="7" Background="{StaticResource ButtonNormal}" Cursor="Hand" Margin="0,0,6,0">
                <TextBlock Text="&#x2212;" Foreground="#E6FFFFFF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="SpeedUpButton" Width="38" Height="30" CornerRadius="7" Background="{StaticResource ButtonNormal}" Cursor="Hand">
                <TextBlock Text="+" Foreground="#E6FFFFFF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <Grid x:Name="BarHost" Grid.Row="1" Background="#FF0B0B0C">
            <Border x:Name="BarTrack" Margin="14,0" Height="3" VerticalAlignment="Top" Background="#2EFFFFFF"/>
            <Border x:Name="BarFill" Margin="14,0" Height="3" VerticalAlignment="Top" HorizontalAlignment="Left" Background="#E6FFFFFF" Width="0"/>
            <TextBlock x:Name="TimeText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" Foreground="#B3FFFFFF" FontSize="11"/>
        </Grid>

        <Border Grid.Row="2" Background="#FF0B0B0C" BorderThickness="0,1,0,0" BorderBrush="#14FFFFFF">
            <ScrollViewer x:Name="ThumbScroller"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly"
                          Focusable="False"
                          Visibility="Collapsed">
                <StackPanel x:Name="ThumbPanel" Orientation="Horizontal" Margin="8,8"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
